---
import WhatsAppButton from './WhatsAppButton.astro';
import { SITE_CONFIG } from '../config/site';
---

<section id="contacto" class="py-16 md:py-24 bg-[#214A35] text-[#FFF8EC] relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest uppercase text-[#C9A45C] mb-4">
      <span>ENCARGOS NAVIDEÑOS · SANTIAGO</span>
    </div>

    <h2 class="font-serif-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#FFF8EC] font-bold leading-tight mb-6 [text-wrap:balance]">
      Esta Navidad, comparte algo especial.
    </h2>

    <p class="text-base sm:text-lg text-[#FFF8EC]/85 max-w-2xl mx-auto leading-relaxed mb-8 font-normal">
      Escríbenos y conversemos sobre tu próximo pedido de Dulce Esencia.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
      <WhatsAppButton message={SITE_CONFIG.messages.cta} variant="white" size="lg" class="w-full sm:w-auto shadow-xl">
        Consultar por WhatsApp
      </WhatsAppButton>
    </div>

    <p class="text-xs sm:text-sm text-[#FFF8EC]/75 mb-8">
      Te atenderemos para coordinar tu encargo.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto text-left pt-6 border-t border-[#FFF8EC]/15">
      <div class="flex items-start gap-3">
        <svg class="w-4 h-4 text-[#C9A45C] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
        <div>
          <span class="text-xs font-semibold text-[#FFF8EC] block">Respuesta directa</span>
          <span class="text-xs text-[#FFF8EC]/70">Atención cordial por WhatsApp ({SITE_CONFIG.phoneDisplay})</span>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <svg class="w-4 h-4 text-[#C9A45C] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <span class="text-xs font-semibold text-[#FFF8EC] block">Planificación anticipada</span>
          <span class="text-xs text-[#FFF8EC]/70">Reserva con tiempo para tus celebraciones navideñas</span>
        </div>
      </div>
    </div>
  </div>
</section>
