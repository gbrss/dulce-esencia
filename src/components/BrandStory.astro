---
import WhatsAppButton from './WhatsAppButton.astro';
import { SITE_CONFIG } from '../config/site';
---

<section id="esencia" class="py-20 md:py-32 bg-[#5A1C2A] relative overflow-hidden">
  <!-- Resplandor de fondo (Dorado y rojo más claro para dar profundidad) -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#C9A45C]/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-[#7B2638]/40 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Columna de la Imagen (Izquierda) -->
      <div class="lg:col-span-5 order-2 lg:order-1 relative reveal-on-scroll">
        <!-- Marco decorativo detrás de la imagen -->
        <div class="absolute -inset-3 bg-gradient-to-tr from-[#C9A45C]/40 to-[#5A1C2A]/50 rounded-[2rem] transform rotate-2 scale-105 blur-md"></div>
        
        <!-- Contenedor de la imagen con flotación constante -->
        <div class="relative rounded-[2rem] overflow-hidden shadow-2xl border-[6px] border-[#FFF8EC]/15 bg-[#FAF2E3] animate-float-slow group">
          <div class="relative overflow-hidden aspect-[4/5]">
            <img
              src="/images/esencia_artesanal_preparacion.jpg"
              alt="Preparación artesanal de infusión de especias naturales para pan de Pascua"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
              loading="lazy"
            />
            <!-- Degradado sutil sobre la imagen para mejorar el contraste -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#5A1C2A]/90 via-transparent to-transparent opacity-80"></div>
          </div>
          
          <!-- Tarjeta flotante sobre la imagen (Glassmorphism adaptado al borgoña) -->
          <div class="absolute bottom-5 left-5 right-5 bg-[#5A1C2A]/85 backdrop-blur-md p-4 rounded-xl shadow-lg border border-[#C9A45C]/30 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-[#C9A45C]/20 flex items-center justify-center shrink-0 border border-[#C9A45C]/40">
                <svg class="w-5 h-5 text-[#C9A45C]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
              </div>
              <div>
                <span class="block text-xs font-bold uppercase tracking-wider text-[#C9A45C] mb-0.5">Infusión Propia</span>
                <span class="text-xs text-[#FFF8EC]/90 font-medium block">Canela, clavo, anís y cítricos</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna de Texto (Derecha) -->
      <div class="lg:col-span-7 order-1 lg:order-2">
        <div class="flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#C9A45C] mb-4 reveal-on-scroll">
          <span class="w-8 h-[2px] bg-[#C9A45C]"></span>
          <span>Nuestra Esencia</span>
        </div>

        <h2 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl text-[#FFF8EC] font-bold leading-[1.15] mb-8 [text-wrap:balance] reveal-on-scroll" style="transition-delay: 100ms;">
          Una tradición que nace del <span class="text-[#C9A45C] italic">cariño.</span>
        </h2>

        <div class="space-y-5 text-base sm:text-lg text-[#FFF8EC]/85 leading-relaxed font-normal">
          <p class="reveal-on-scroll" style="transition-delay: 200ms;">
            En <strong class="font-bold text-[#C9A45C]">Dulce Esencia</strong> creemos que los mejores sabores se disfrutan sin apuro. Preparamos nuestros panes de Pascua de manera casera, cuidando cada detalle y utilizando una esencia natural elaborada por nosotros.
          </p>
          <p class="reveal-on-scroll" style="transition-delay: 300ms;">
            A diferencia de las producciones industriales masivas, nuestro proceso comienza infusionando especias nobles a fuego suave, logrando un aroma profundo y una miga húmeda que evoca las Navidades de antaño en los hogares chilenos.
          </p>
        </div>

        <!-- Cita Destacada -->
        <div class="mt-8 mb-10 relative pl-6 reveal-on-scroll" style="transition-delay: 400ms;">
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-[#C9A45C] to-[#C9A45C]/20 rounded-full"></div>
          <svg class="absolute -top-2 -left-2 w-8 h-8 text-[#C9A45C]/20 transform -scale-x-100" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
          <p class="font-serif-display italic text-xl sm:text-2xl text-[#FFF8EC]">
            “Un sabor pensado para compartir y disfrutar en familia.”
          </p>
        </div>

        <!-- Botón -->
        <div class="pt-6 border-t border-[#FFF8EC]/15 reveal-on-scroll" style="transition-delay: 500ms;">
          <WhatsAppButton message={SITE_CONFIG.messages.essence} variant="gold" size="md" class="hover:-translate-y-1 transition-transform duration-300 shadow-lg">
            Consultar sobre nuestra elaboración
          </WhatsAppButton>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Animación de flotación constante para la imagen */
  @keyframes floatSlow {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(1deg); }
  }
  
  .animate-float-slow {
    animation: floatSlow 8s ease-in-out infinite;
  }

  /* Clases para el efecto Scroll Reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .animate-float-slow { animation: none; }
    .reveal-on-scroll { 
      opacity: 1; 
      transform: none; 
      transition: none;
    }
  }
</style>

<script>
  // Intersection Observer para activar las animaciones al hacer scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); // Solo animar una vez
      }
    });
  }, {
    threshold: 0.15,
    rootMargin: "0px 0px -50px 0px"
  });

  document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>