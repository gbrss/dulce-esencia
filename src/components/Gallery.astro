---
import WhatsAppButton from './WhatsAppButton.astro';
import { GALLERY_ITEMS } from '../data/gallery';

// Enriquecemos las descripciones directamente aquí o puedes hacerlo en gallery.ts
const enrichedItems = GALLERY_ITEMS.map(item => ({
  ...item,
  // Añadimos un pequeño detalle extra a la descripción visual
  richDescription: item.description.length > 80 ? item.description : `${item.description} Una verdadera delicia artesanal.`
}));
---

<section id="galeria" class="py-20 md:py-28 bg-[#FFF8EC] relative overflow-hidden">
  <!-- Textura de fondo sutil (puntos) -->
  <div class="absolute inset-0 bg-[radial-gradient(#C9A45C_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#7B2638]/5 text-xs font-bold tracking-widest uppercase text-[#7B2638] mb-4 border border-[#7B2638]/10">
        <span>Galería Fotográfica</span>
        <span aria-hidden="true" class="text-[#C9A45C]">·</span>
        <span>Dulce Esencia</span>
      </div>

      <h2 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl text-[#4A3028] font-bold [text-wrap:balance]">
        Pequeños detalles, <span class="text-[#7B2638] italic">grandes momentos.</span>
      </h2>

      <p class="text-sm sm:text-base text-[#4A3028]/75 mt-4 leading-relaxed">
        Cada imagen refleja la dedicación artesanal, la calidad de nuestros ingredientes y la calidez de compartir una tradición en familia.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {enrichedItems.map((item, idx) => (
        <div 
          class="group relative bg-white rounded-2xl overflow-hidden border border-[#C9A45C]/20 shadow-sm flex flex-col transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 hover:border-[#C9A45C]/50 reveal-on-scroll"
          style={`transition-delay: ${idx * 100}ms;`}
        >
          <!-- Contenedor de la Imagen -->
          <div
            class="relative aspect-[4/3] overflow-hidden cursor-pointer gallery-card bg-[#FAF2E3]"
            data-index={idx}
            data-title={item.title}
            data-subtitle={item.subtitle}
            data-desc={item.richDescription}
            data-img={item.imageSrc}
            data-msg={item.whatsappMessage}
            data-cat={item.category}
          >
            <img
              src={item.imageSrc}
              alt={item.alt}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 animate-zoom-slow"
              loading="lazy"
            />
            
            <!-- Overlay con efecto de cristal al hacer hover -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#4A3028]/80 via-[#4A3028]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
              <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FFF8EC]/90 backdrop-blur-md text-[#4A3028] text-xs font-bold shadow-lg transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                <svg class="w-4 h-4 text-[#7B2638]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                Ver fotografía ampliada
              </span>
            </div>
            
            <!-- Etiqueta de categoría flotante -->
            <div class="absolute top-4 left-4 bg-[#FFF8EC]/90 backdrop-blur-sm px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider text-[#7B2638] shadow-sm transform -translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
              {item.category}
            </div>
          </div>

          <!-- Contenido de la Tarjeta -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif-display text-xl font-bold text-[#4A3028] mb-2 leading-tight group-hover:text-[#7B2638] transition-colors duration-300">
                {item.title}
              </h3>
              <p class="text-xs text-[#4A3028]/70 leading-relaxed line-clamp-3">
                {item.richDescription}
              </p>
            </div>
            
            <div class="pt-5 mt-4 border-t border-[#C9A45C]/20">
              <!-- Botón renovado -->
              <WhatsAppButton message={item.whatsappMessage} variant="outline" size="sm" class="w-full justify-center text-xs border-[#7B2638]/30 text-[#7B2638] hover:bg-[#7B2638] hover:text-[#FFF8EC] hover:border-[#7B2638] transition-all duration-300">
                Consultar esta opción
              </WhatsAppButton>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Nota inferior -->
    <div class="mt-12 p-5 rounded-xl bg-[#FAF2E3]/60 border border-[#C9A45C]/20 text-center text-xs text-[#4A3028]/70 max-w-2xl mx-auto flex items-center justify-center gap-3 backdrop-blur-sm reveal-on-scroll" style="transition-delay: 600ms;">
      <svg class="w-5 h-5 text-[#C9A45C] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <p><strong class="text-[#7B2638]">Nota gastronómica:</strong> Fotografías de muestra artesanal para Dulce Esencia. Las presentaciones reales se coordinan directamente al encargar.</p>
    </div>
  </div>

  <!-- MODAL LIGHTBOX PREMIUM -->
  <div id="gallery-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-[#4A3028]/90 backdrop-blur-md" role="dialog" aria-modal="true" aria-hidden="true">
    <!-- Contenedor con animación de entrada -->
    <div id="lightbox-content" class="relative bg-[#FFF8EC] rounded-3xl max-w-5xl w-full overflow-hidden shadow-[0_0_50px_rgba(201,164,92,0.2)] border border-[#C9A45C]/40 flex flex-col md:flex-row transform scale-95 opacity-0 transition-all duration-300">
      
      <!-- Botón de cerrar -->
      <button
        type="button"
        id="lightbox-close"
        class="absolute top-4 right-4 z-20 p-2.5 rounded-full bg-white/80 backdrop-blur-md text-[#4A3028] hover:bg-[#7B2638] hover:text-[#FFF8EC] transition-all duration-300 cursor-pointer shadow-lg group-hover:rotate-90"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>

      <!-- Imagen del Modal -->
      <div class="relative w-full md:w-3/5 h-64 md:h-auto bg-[#FAF2E3] overflow-hidden group/img md:rounded-l-3xl">
      <!-- El scale-105 base evita que el borde del contenedor se asome -->
      <img id="lightbox-img" src="" alt="" class="w-full h-full object-cover animate-zoom-modal scale-105" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>
    </div>

      <!-- Contenido del Modal -->
      <div class="w-full md:w-2/5 p-6 sm:p-8 flex flex-col justify-center bg-[#FFF8EC] relative">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[#C9A45C] to-[#7B2638]"></div>
        
        <span id="lightbox-cat" class="inline-block px-2.5 py-1 rounded bg-[#7B2638]/10 text-[10px] font-bold tracking-wider uppercase text-[#7B2638] mb-3 self-start"></span>
        
        <h3 id="lightbox-title" class="font-serif-display text-2xl sm:text-3xl font-bold text-[#4A3028] mb-2 leading-tight"></h3>
        
        <p id="lightbox-subtitle" class="text-sm font-semibold text-[#C9A45C] mb-4"></p>
        
        <p id="lightbox-desc" class="text-sm text-[#4A3028]/80 leading-relaxed mb-8 font-normal flex-grow"></p>

        <div class="pt-5 border-t border-[#C9A45C]/25 flex flex-col gap-3">
          <a
            id="lightbox-cta"
            href=""
            target="_blank"
            rel="noopener noreferrer"
            class="w-full text-center px-5 py-3 text-sm rounded-xl bg-[#214A35] text-[#FFF8EC] hover:bg-[#183928] font-bold transition-all duration-300 shadow-md flex items-center justify-center gap-2 animate-pulse-wa"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Consultar por WhatsApp
          </a>
          <button id="lightbox-close-btn" class="text-xs text-[#4A3028]/50 hover:text-[#7B2638] transition-colors underline underline-offset-2">
            Volver a la galería
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Animaciones para Scroll Reveal */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Estado del Modal Abierto */
  #gallery-lightbox.is-open #lightbox-content {
    transform: scale(1);
    opacity: 1;
  }

  /* Zoom lento y constante para las tarjetas de la galería */
  @keyframes zoomSlow {
    0% { transform: scale(1); }
    50% { transform: scale(1.08); } /* Aumenta un 8% */
    100% { transform: scale(1); }
  }
  
  .animate-zoom-slow {
    animation: zoomSlow 15s ease-in-out infinite;
  }

  /* Zoom para la imagen del modal al abrirse */
  @keyframes zoomModal {
    from { transform: scale(1.1); }
    to { transform: scale(1); }
  }
  
  .animate-zoom-modal {
    animation: zoomModal 8s ease-out forwards;
  }

  /* Ajuste: Desactivar el zoom lento al hacer hover para que no choquen las animaciones */
  .group:hover .animate-zoom-slow {
    animation-play-state: paused;
    transform: scale(1.15); /* El zoom brusco del hover */
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .reveal-on-scroll { opacity: 1; transform: none; transition: none; }
    #lightbox-content { transform: scale(1); opacity: 1; transition: none; }
    .group:hover .group-hover\:scale-110 { transform: none; }
    .animate-zoom-slow, .animate-zoom-modal { animation: none; transform: none; }
  }
    /* Efecto pulsante para el botón de WhatsApp del modal */
  @keyframes pulseWA {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(33, 74, 53, 0.6);
    }
    50% {
      transform: scale(1.03);
      box-shadow: 0 0 0 10px rgba(33, 74, 53, 0);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(33, 74, 53, 0);
    }
  }

  .animate-pulse-wa {
    animation: pulseWA 2s infinite;
  }

  /* Pausar la animación si el usuario pone el mouse encima (para que pueda hacer clic cómodo) */
  .animate-pulse-wa:hover {
    animation-play-state: paused;
    transform: scale(1.02); /* Pequeño zoom al hacer hover */
  }

  /* Accesibilidad: desactivar la animación si el usuario prefiere movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .animate-pulse-wa {
      animation: none;
    }
  }
</style>

<script>
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxContent = document.getElementById('lightbox-content');
  const closeBtns = [document.getElementById('lightbox-close'), document.getElementById('lightbox-close-btn')];
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const title = document.getElementById('lightbox-title');
  const subtitle = document.getElementById('lightbox-subtitle');
  const desc = document.getElementById('lightbox-desc');
  const cat = document.getElementById('lightbox-cat');
  const cta = document.getElementById('lightbox-cta') as HTMLAnchorElement;

  const openLightbox = (card: HTMLElement) => {
    if (!lightbox || !img || !title || !subtitle || !desc || !cat || !cta) return;
    
    img.src = card.dataset.img || '';
    img.alt = card.dataset.title || '';
    title.textContent = card.dataset.title || '';
    subtitle.textContent = card.dataset.subtitle || '';
    desc.textContent = card.dataset.desc || '';
    cat.textContent = card.dataset.cat || '';
    
    const msg = card.dataset.msg || '¡Hola! Quisiera consultar sobre esta opción.';
    cta.href = `https://wa.me/56950075329?text=${encodeURIComponent(msg)}`;

    // Reiniciamos la animación del modal cada vez que se abre
    const modalImg = document.getElementById('lightbox-img');
    if (modalImg) {
      modalImg.style.animation = 'none';
      modalImg.offsetHeight; /* Trigger reflow */
      modalImg.style.animation = ''; 
    }

    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    
    setTimeout(() => {
      lightbox.classList.add('is-open');
    }, 10);
    
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    
    setTimeout(() => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }, 300);
    
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = 'unset';
  };

  document.querySelectorAll('.gallery-card').forEach((card) => {
    card.addEventListener('click', () => openLightbox(card as HTMLElement));
  });

  closeBtns.forEach(btn => {
    if (btn) btn.addEventListener('click', closeLightbox);
  });

  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && lightbox.classList.contains('is-open')) {
      closeLightbox();
    }
  });

  // Intersection Observer para las tarjetas de la galería
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

  document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>