---
import WhatsAppButton from './WhatsAppButton.astro';
import { SITE_CONFIG } from '../config/site';
---

<header class="sticky top-0 z-40 transition-all duration-200 bg-[#FFF8EC]/95 backdrop-blur-md border-b border-[#C9A45C]/20 py-2">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-8">
      {/* Zona 1: Logo */}
      <a href="#inicio" class="flex items-center gap-3 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#7B2638] rounded-md" aria-label="Dulce Esencia - Ir al inicio">
        <img src="/logo.svg" alt="Logotipo Dulce Esencia Pan de Pascua Casero" class="h-14 sm:h-16 w-auto object-contain" />
      </a>

      {/* Zona 2: Enlaces */}
      <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-8 text-sm font-medium text-[#4A3028]">
        {SITE_CONFIG.navLinks.map((link) => (
          <a href={link.href} class="whitespace-nowrap shrink-0 hover:text-[#7B2638] transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#7B2638] hover:after:w-full after:transition-all after:duration-200">
            {link.label}
          </a>
        ))}
      </nav>

      {/* Zona 3: CTA & Mobile trigger */}
      <div class="flex items-center gap-3 shrink-0">
        <div class="hidden sm:block">
          <WhatsAppButton message={SITE_CONFIG.messages.hero} variant="primary" size="sm">
            Encargar por WhatsApp
          </WhatsAppButton>
        </div>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="md:hidden p-2 text-[#4A3028] hover:text-[#7B2638] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#7B2638] rounded-md cursor-pointer"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Menú móvil desplegable con animación suave */}
  <div 
    id="mobile-menu" 
    class="md:hidden absolute top-full left-0 w-full bg-[#FFF8EC] border-b border-[#C9A45C]/30 shadow-xl overflow-hidden transition-all duration-500 ease-in-out opacity-0 max-h-0 pointer-events-none"
  >
    <div class="px-6 py-6 flex flex-col gap-4">
      <span class="text-xs uppercase tracking-widest text-[#7B2638] font-semibold">Navegación</span>
      
      {SITE_CONFIG.navLinks.map((link, index) => (
        <a 
          href={link.href} 
          class="mobile-link opacity-0 translate-y-4 text-base font-medium text-[#4A3028] hover:text-[#7B2638] py-2 border-b border-[#C9A45C]/15 transition-all duration-300"
          style={`transition-delay: ${index * 50}ms;`}
        >
          {link.label}
        </a>
      ))}
      
      <div class="pt-2 mobile-link opacity-0 translate-y-4 transition-all duration-300" style="transition-delay: 250ms;">
        <WhatsAppButton message={SITE_CONFIG.messages.hero} variant="primary" size="md" class="w-full justify-center">
          Encargar por WhatsApp
        </WhatsAppButton>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      
      if (!isExpanded) {
        // Abrir menú
        toggleBtn.setAttribute('aria-expanded', 'true');
        menu.classList.remove('max-h-0', 'opacity-0', 'pointer-events-none');
        menu.classList.add('max-h-[500px]', 'opacity-100', 'pointer-events-auto');
        
        // Mostrar enlaces en cascada
        mobileLinks.forEach(link => {
          link.classList.remove('opacity-0', 'translate-y-4');
          link.classList.add('opacity-100', 'translate-y-0');
        });
      } else {
        // Cerrar menú
        toggleBtn.setAttribute('aria-expanded', 'false');
        menu.classList.remove('max-h-[500px]', 'opacity-100', 'pointer-events-auto');
        menu.classList.add('max-h-0', 'opacity-0', 'pointer-events-none');
        
        // Ocultar enlaces
        mobileLinks.forEach(link => {
          link.classList.remove('opacity-100', 'translate-y-0');
          link.classList.add('opacity-0', 'translate-y-4');
        });
      }
    });

    // Cerrar al hacer clic en un enlace
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        menu.classList.remove('max-h-[500px]', 'opacity-100', 'pointer-events-auto');
        menu.classList.add('max-h-0', 'opacity-0', 'pointer-events-none');
        
        mobileLinks.forEach(l => {
          l.classList.remove('opacity-100', 'translate-y-0');
          l.classList.add('opacity-0', 'translate-y-4');
        });
      });
    });
  }
</script>