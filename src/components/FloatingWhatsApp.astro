---
import { SITE_CONFIG, getWhatsAppUrl } from '../config/site';

const url = getWhatsAppUrl(SITE_CONFIG.messages.default);
---

<aside aria-label="Contacto flotante" class="fixed bottom-5 right-5 z-40 flex items-center gap-3 pointer-events-auto">
  <div id="wa-tooltip" class="hidden sm:block opacity-0 transition-opacity duration-200 bg-[#4A3028] text-[#FFF8EC] text-xs font-medium py-2 px-3.5 rounded-lg shadow-lg border border-[#C9A45C]/40 whitespace-nowrap pointer-events-none">
    <span>¿Deseas encargar? ¡Conversemos por WhatsApp!</span>
  </div>

  <a
    id="wa-float-btn"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Abrir chat de WhatsApp con Dulce Esencia al +56 9 5007 5329"
    class="relative w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-[#214A35] text-[#FFF8EC] flex items-center justify-center shadow-xl hover:bg-[#183928] hover:scale-105 active:scale-95 transition-all duration-200 border-2 border-[#FFF8EC]/20 cursor-pointer wa-pulse"
  >
    <span class="wa-ping-ring absolute inset-0 rounded-full bg-[#214A35]/60 -z-10"></span>
    <svg class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </a>
</aside>

<style>
  /* Halo que se expande desde el botón */
  .wa-ping-ring {
    animation: wa-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes wa-ping {
    0%   { transform: scale(1);   opacity: 0.7; }
    70%  { transform: scale(1.9); opacity: 0;   }
    100% { transform: scale(1.9); opacity: 0;   }
  }

  /* Balanceo sutil del icono (se detiene al hover) */
  .wa-pulse:hover svg {
    animation: wa-wiggle 0.6s ease-in-out;
  }

  @keyframes wa-wiggle {
    0%, 100% { transform: rotate(0deg); }
    25%      { transform: rotate(-8deg); }
    75%      { transform: rotate(8deg); }
  }

  /* Respeta usuarios con preferencia de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .wa-ping-ring { animation: none; opacity: 0; }
    .wa-pulse:hover svg { animation: none; }
  }
</style>

<script>
  const floatBtn = document.getElementById('wa-float-btn');
  const tooltip = document.getElementById('wa-tooltip');

  if (floatBtn && tooltip) {
    floatBtn.addEventListener('mouseenter', () => {
      tooltip.classList.remove('opacity-0');
      tooltip.classList.add('opacity-100');
    });
    floatBtn.addEventListener('mouseleave', () => {
      tooltip.classList.remove('opacity-100');
      tooltip.classList.add('opacity-0');
    });
  }
</script>